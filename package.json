{
  "name": "dd-devdiary",
  "displayName": "DD (DevDiary)",
  "description": "Save, organize and annotate important code snippets directly inside VS Code. Dev Info Diary lets you store selected lines as structured notes with tags, priorities, gutter indicators and export support.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:dd-devdiary.open",
    "onCommand:dd-devdiary.addSelection",
    "onCommand:dd-devdiary.quickSave"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dd-devdiary.open",
        "title": "DD (DevDiary): Open Panel"
      },
      {
        "command": "dd-devdiary.addSelection",
        "title": "DD (DevDiary): Add Selection to Diary"
      },
      {
        "command": "dd-devdiary.quickSave",
        "title": "DD (DevDiary): Quick Save Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dd-devdiary.addSelection",
          "when": "editorHasSelection",
          "group": "devdiary@1"
        },
        {
          "command": "dd-devdiary.quickSave",
          "when": "editorHasSelection",
          "group": "devdiary@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {}
}
